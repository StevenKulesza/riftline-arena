{
  "name": "riftline-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "audio:generate": "bash scripts/generate-weapon-audio.sh",
    "audio:regenerate": "bash scripts/generate-weapon-audio.sh --force",
    "audio:countdown": "bash scripts/generate-countdown-audio.sh",
    "audio:master": "bash scripts/master-weapon-audio.sh",
    "map:convert": "node scripts/convert-wca1-bsp.mjs",
    "map:materials": "node scripts/import-wca1-materials.mjs",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
